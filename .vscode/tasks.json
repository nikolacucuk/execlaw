{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "web: test",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"--prefix",
				"web",
				"test",
				"--",
				"--maxWorkers=2"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "web: build",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"--prefix",
				"web",
				"run",
				"build"
			],
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "web: lint",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"--prefix",
				"web",
				"run",
				"lint"
			],
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "web: size",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"--prefix",
				"web",
				"run",
				"size"
			],
			"problemMatcher": []
		},
		{
			"label": "web: appearance checks",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"--prefix",
				"web",
				"run",
				"test:appearance"
			],
			"problemMatcher": []
		},
		{
			"label": "web: install Chromium",
			"type": "shell",
			"command": "node",
			"args": [
				"web/node_modules/@playwright/test/cli.js",
				"install",
				"chromium"
			],
			"problemMatcher": []
		},
		{
			"label": "web: audit",
			"type": "shell",
			"command": "npm",
			"windows": {
				"command": "npm.cmd"
			},
			"args": [
				"--prefix",
				"web",
				"audit"
			],
			"problemMatcher": []
		},
		{
			"label": "web: verify",
			"dependsOrder": "sequence",
			"dependsOn": [
				"web: test",
				"web: lint",
				"web: build",
				"web: size",
				"web: appearance checks",
				"web: audit"
			],
			"problemMatcher": []
		},
		{
			"label": "graphify: update",
			"type": "shell",
			"command": "graphify",
			"windows": {
				"command": "${env:USERPROFILE}\\.local\\bin\\graphify.exe"
			},
			"args": [
				"update",
				"."
			],
			"problemMatcher": []
		},
		{
			"label": "rust: build control plane",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--locked",
				"-p",
				"execlaw",
				"--target-dir",
				"target-local-execlaw"
			],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "rust: message history tests",
			"type": "shell",
			"command": "cargo",
			"args": [
				"test",
				"--locked",
				"-p",
				"execlaw-server",
				"--lib",
				"list_messages",
				"--target-dir",
				"target-local-execlaw"
			],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "rust: runner release final",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--locked",
				"--release",
				"--bin",
				"execlaw-runner",
				"--no-default-features",
				"--target-dir",
				"target-release-runner"
			],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "rust: process check",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process cargo,rustc -ErrorAction SilentlyContinue | Select-Object ProcessName,Id,CPU"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "rust: stop validation compilers",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process cargo,rustc -ErrorAction SilentlyContinue | Stop-Process -Force"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "rust: control release final",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--locked",
				"--release",
				"-p",
				"execlaw",
				"--target-dir",
				"target-release-execlaw"
			],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "rust: control release verified",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--locked",
				"--release",
				"-p",
				"execlaw",
				"--target-dir",
				"target-release-control-verified"
			],
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "rust: release process check",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process cargo,rustc -ErrorAction SilentlyContinue | Select-Object ProcessName,Id,CPU"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "rust: release artifact check",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Item target-release-control-verified\\release\\execlaw.exe -ErrorAction SilentlyContinue | Select-Object FullName,Length,LastWriteTime"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}