{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "expected_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
          "content": {"type": "string", "maxLength": 10485760}
        },
        "required": ["path", "expected_sha256", "content"],
        "additionalProperties": false
      }
    }
  },
  "required": ["edits"],
  "additionalProperties": false
}
