{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixture_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Workspace-relative SQL fixture used to create realistic starting tables and rows."
    },
    "migration_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  },
  "required": ["fixture_path", "migration_paths"],
  "additionalProperties": false
}
