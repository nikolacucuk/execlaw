{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chain.plan args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "Plain-language objective to decompose into tool steps."
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "default": 6
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "effect_kind": { "type": "string" },
          "payload": {}
        },
        "required": ["label"]
      }
    }
  },
  "required": ["objective"]
}
