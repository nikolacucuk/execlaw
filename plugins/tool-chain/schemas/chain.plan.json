{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chain.plan args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "Plain-language objective to decompose into tool steps."
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "default": 6
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "effect_kind": { "type": "string" },
          "payload": {},
          "resource_keys": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 256 },
            "maxItems": 64,
            "description": "Provider-observed resource keys whose versions are captured by prepare and checked again at execution."
          },
          "compensation": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "effect_kind": { "type": "string", "minLength": 1 },
              "payload": {},
              "resource_keys": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 256 },
                "maxItems": 64
              }
            },
            "required": ["label", "effect_kind"],
            "additionalProperties": false
          }
        },
        "required": ["label"]
      }
    }
  },
  "required": ["objective"]
}
